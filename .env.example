# PrivaStream environment variables
# Copy to `.env` and fill in real values. Do NOT commit `.env`.
# Variable names below match what the code actually reads
# (src/web/frontend/lib/config.ts, src/web/mediasoup/config.js,
#  src/web/mediasoup/server.js, src/web/backend/app.py).

# Local commands expect a repository-local virtual environment:
#   python -m venv .venv
#   . .\.venv\Scripts\Activate.ps1
#   source .venv/bin/activate

# ---------------------------------------------------------------------------
# Backend (Flask app.py) — REQUIRED
# ---------------------------------------------------------------------------
# Session signing key. The app should fail to start if this is unset (see
# Phase 3). Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# "production" or "development"
FLASK_ENV=development
REQUIRE_AUTH=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
ROOM_TTL_SECONDS=21600
ROOM_EMBEDDING_TTL_SECONDS=21600
VIDEO_API_WORKERS=1
VIDEO_API_THREADS=8
VIDEO_FILTER_MAX_CONCURRENT_REQUESTS=10
VIDEO_FILTER_MAX_REQUEST_AGE_MS=1000

# ---------------------------------------------------------------------------
# mediasoup SFU (server.js / config.js)
# ---------------------------------------------------------------------------
NODE_ENV=development
# Interface the SFU binds to inside the container/host.
MEDIASOUP_LISTEN_IP=0.0.0.0
# Public IP advertised to WebRTC clients. MUST be the host's reachable IP in
# production — '127.0.0.1' only works for local-only testing.
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
PUBLIC_SFU_URL=http://localhost:3001
# Service URLs the SFU calls (no NEXT_PUBLIC_ prefix — server-side).
BACKEND_URL=http://localhost:5000
SFU_URL=http://localhost:3001
VIDEO_API_URL=http://localhost:5001
AUDIO_API_URL=http://localhost:5002

# ---------------------------------------------------------------------------
# Frontend (Next.js) — must be prefixed NEXT_PUBLIC_ to reach the browser
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_SFU_URL=http://localhost:3001
NEXT_PUBLIC_VIDEO_API_URL=http://localhost:5001
NEXT_PUBLIC_AUDIO_API_URL=http://localhost:5002
